{
	"version": "2.0.0",
	"windows": {
		"command": ".vscode/build.bat",
	},
	"linux": {
		"args": [],
		"command": "ninja"
	},
	"osx": {
		"args": [],
		"command": "ninja"
	},
	"options": {
		"env": {
			"LANG": "C.UTF-8",
			"PYTHONUNBUFFERD": "1",
			"MSYSTEM": "MINGW64"
		}
	},
	"tasks": [
		{
			"label": "build",
			"problemMatcher": [],
			"group": {
				"kind": "build",
				"isDefault": true
			}
		}
	],
	"presentation": {
		"echo": true,
		"panel": "shared",
		"showReuseMessage": true,
		"clear": true,
		"revealProblems": "never"
	}
}
